# 默认可直接用英文资料摘录，不调用付费接口。
RAG_LLM_PROVIDER=extractive
RAG_HOST=127.0.0.1
RAG_PORT=8010
# 单个服务进程最多同时执行四个问答；满额返回 503 QUERY_CAPACITY。
RAG_MAX_CONCURRENT_QUERIES=4
# 实际模型上下文最多八个授权片段；生成格式或语言纠正最多一次（总共两次生成）。
RAG_CONTEXT_MAX_CHUNKS=8
RAG_GENERATION_MAX_ATTEMPTS=2
# 需要大模型总结时复制为本项目 .env，再填写自己的密钥：
# RAG_LLM_PROVIDER=compatible
# RAG_LLM_API_KEY=
# RAG_LLM_BASE_URL=https://api.deepseek.com
# RAG_LLM_MODEL=deepseek-chat
# 金额不会默认估算。两项价格使用同一种货币，单位是每百万 Token：
# RAG_INPUT_PRICE_PER_MILLION=
# RAG_OUTPUT_PRICE_PER_MILLION=
# 开放给其他机器前配置高强度令牌，并禁用本机演示令牌：
# RAG_ALLOW_DEMO_AUTH=false
# RAG_TOKENS_JSON={"随机令牌至少24字符":{"user_id":"alice","tenant_id":"team1","departments":["ops"],"admin":false}}
